# Alla nycklar är valfria utom ANTHROPIC_API_KEY (för nyhetsanalysen).
# Saknas en källa går analysen ändå igenom, med lägre konfidens och en flagga.

# Svenska Spel: utan nyckel används det publika JSON-API:t.
SVENSKASPEL_ACCESS_KEY=

# The Odds API (gratisnivå, 500 krediter/mån): https://the-odds-api.com
ODDS_API_KEY=

# Claude API för skador, avstängningar, motivation och nyheter.
ANTHROPIC_API_KEY=
NEWS_MODEL=claude-opus-5-5

# Cache: "file" (data/cache, för lokal utveckling) eller "supabase".
CACHE_BACKEND=file
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
